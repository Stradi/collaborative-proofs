#!/usr/bin/env bash
# Judges a proof PR. Runs from the trusted base checkout and reads the PR head only as data.
# Usage: ci-check <base-checkout> <pr-head-checkout> <work-dir> [frozen-revision] [pr-head-revision]
#        ci-check <base-checkout> --assemble <work-dir> <assembly-manifest>
#        ci-check <base-checkout> --plan <work-dir> <PR-head-revision>
#        ci-check <base-checkout> --revision <work-dir> <PR-head-revision>
# Writes <work-dir>/out/verdict.json. Exit codes: 0 accepted, 1 rejected, 2 checker fault.
set -uo pipefail

base=$(realpath "$1")
input=$2
assembly=""
plan_input=false
case $input in
  --assemble) assembly=$(realpath "$4") ;;
  --plan | --revision) plan_input=true ;;
  *) submission=$(realpath "$input") ;;
esac
work=$(realpath -m "$3")
# shellcheck source=lib.sh
. "$base/scripts/checker/lib.sh"

out=$work/out
workspace=$work/workspace
claim_export=$work/claim
submission_export=$work/submission
rm -rf "$out" "$claim_export" "$submission_export"
mkdir -p "$out" "$claim_export" "$submission_export" "$work/home"
: "${CHECK_MEMORY:=6g}" "${CHECK_CPUS:=2}" "${CHECK_PIDS:=1024}"
: "${CHECK_BUILD_TIMEOUT:=1200}" "${CHECK_JUDGE_TIMEOUT:=900}"

base_sha=$(git -C "$base" rev-parse HEAD)
head_sha=""
frozen_sha=""
task="" proof="" digest=""

finish() {
  local verdict=$1 stage=$2 reason=$3 code
  case $verdict in accepted) code=0 ;; rejected) code=1 ;; *) code=2 ;; esac
  jq -n --arg verdict "$verdict" --arg stage "$stage" --arg task "$task" \
    --arg proof "$proof" --arg digest "$digest" --arg base "$base_sha" \
    --arg frozen "$frozen_sha" --arg head "$head_sha" --arg reason "$reason" \
    '{verdict:$verdict,stage:$stage,task:$task,proof_file:$proof,proof_sha256:$digest,
      base_sha:$base,frozen_sha:$frozen,head_sha:$head,reason:$reason}' >"$out/verdict.json" || exit 2
  log "$verdict at $stage"
  printf '%s\n' "$reason" | sed 's/^/    /' >&2
  if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
    printf '### Proof check: %s\n\n- Task: `%s`\n- Stage: %s\n- Head: `%s`\n' \
      "$verdict" "${task:-unknown}" "$stage" "$head_sha" >>"$GITHUB_STEP_SUMMARY"
  fi
  exit "$code"
}

docker_user() {
  # Rootless Docker maps container root to the invoking user; rootful Docker needs the runner's uid.
  if docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then
    echo 0:0
  else
    echo "$(id -u):$(id -g)"
  fi
}

# Usage: sandboxed <seconds> [docker volume and workdir options] -- <command>
sandboxed() {
  local seconds=$1
  local -a mounts=()
  shift
  while [[ $1 != -- ]]; do mounts+=("$1"); shift; done
  shift
  docker run --rm --network none --user "$(docker_user)" \
    --memory "$CHECK_MEMORY" --memory-swap "$CHECK_MEMORY" --cpus "$CHECK_CPUS" \
    --pids-limit "$CHECK_PIDS" --cap-drop ALL --security-opt no-new-privileges \
    --read-only --tmpfs /tmp:rw,exec,size=1g \
    --env HOME=/tmp --env "ELAN_HOME=$ELAN_HOME" --env "PATH=$PATH" --env LEAN_ABORT_ON_PANIC=1 \
    --volume "$ELAN_HOME:$ELAN_HOME:ro" "${mounts[@]}" \
    proof-sandbox timeout --kill-after=10 "$seconds" "$@"
}

frozen_revision=${4:-$base_sha}
if [[ -n $assembly ]]; then
  frozen_revision=$(jq -er '.frozen' "$assembly") || finish fault setup "missing assembly revision"
fi
if "$plan_input"; then frozen_revision=$4; head_sha=$4; fi
[[ $frozen_revision =~ ^[a-f0-9]{40}$ ]] || finish fault setup "invalid frozen revision"
frozen_sha=$(git -C "$base" rev-parse --verify "$frozen_revision^{commit}") ||
  finish fault setup "the frozen revision is unavailable"
rm -rf "$workspace" && mkdir -p "$workspace"
git -C "$base" archive "$frozen_sha" | tar -x -C "$workspace" ||
  finish fault setup "could not copy the frozen checkout"

stage_task_proof() {
  head_sha=$(git -C "$submission" rev-parse --verify "${1:-HEAD}^{commit}") || finish fault files "missing PR head"
  log "Checking $head_sha against base $base_sha and frozen inputs $frozen_sha"
  local merge_base changes change_kind matching
  merge_base=$(git -C "$submission" merge-base "$base_sha" "$head_sha") ||
    finish fault files "could not find the merge base of the PR and $base_sha"
  changes=$(git -C "$submission" diff --no-renames --name-status "$merge_base" "$head_sha") ||
    finish fault files "could not read the PR diff"
  [[ $(grep -c . <<<"$changes") -eq 1 ]] ||
    finish rejected files "a proof PR must change exactly one task proof file"
  change_kind=${changes%%$'\t'*}
  matching=${changes#*$'\t'}
  for config in "$workspace"/problems/*/tasks/*.json; do
    if [[ $(module_path "$(json_string solution_module "$config")") == "$matching" ]]; then
      local problem_dir=${config%/tasks/*}
      task="${problem_dir##*/}/$(basename "$config" .json)"
      proof=$matching
      break
    fi
  done
  [[ -n $task ]] || finish rejected files "the changed file is not a frozen task proof file"
  [[ $change_kind == A && ! -e $workspace/$proof ]] ||
    finish rejected files "a submission must add a new proof file"
  [[ $(git -C "$submission" ls-tree "$head_sha" -- "$proof" | cut -d ' ' -f 1) == 100644 ]] ||
    finish rejected files "$proof must be a regular file"
  git -C "$submission" show "$head_sha:$proof" >"$workspace/$proof" ||
    finish fault setup "could not read $proof"
  digest=$(sha256sum "$workspace/$proof" | cut -d ' ' -f 1)
  lint_staged_proof "$config" "$proof"
}

lint_staged_proof() {
  local config=$1 path=$2 reasons challenge
  challenge=$(module_path "$(json_string challenge_module "$config")")
  if ! reasons=$(lint_proof "$workspace/$path" "$workspace/$challenge"); then
    finish rejected rules "$reasons"
  fi
}

stage_assembly() {
  task=$(jq -er '.problem' "$assembly") || finish fault setup "missing assembly problem"
  [[ $task =~ ^[a-z0-9-]+$ ]] || finish fault setup "invalid assembly problem"
  local task_config path sha expected count=0
  for task_config in "$workspace/problems/$task"/tasks/*.json; do
    [[ -f $task_config ]] || finish fault setup "missing frozen task configuration"
    path=$(module_path "$(json_string solution_module "$task_config")")
    sha=$(jq -er --arg path "$path" '[.proofs[] | select(.path == $path)] | select(length == 1) | .[0].sha' "$assembly") ||
      finish fault setup "missing accepted proof for $path"
    expected=$(jq -er --arg path "$path" '.proofs[] | select(.path == $path) | .digest' "$assembly") ||
      finish fault setup "missing accepted digest for $path"
    [[ $sha =~ ^[a-f0-9]{40}$ && $expected =~ ^[a-f0-9]{64}$ ]] ||
      finish fault setup "invalid accepted proof reference for $path"
    [[ $(git -C "$base" ls-tree "$sha" -- "$path" | cut -d ' ' -f 1) == 100644 ]] ||
      finish fault setup "missing regular file $path at $sha"
    git -C "$base" show "$sha:$path" >"$workspace/$path" ||
      finish fault setup "could not read accepted proof $path"
    [[ $(sha256sum "$workspace/$path" | cut -d ' ' -f 1) == "$expected" ]] ||
      finish rejected assembly "merged proof digest mismatch for $path"
    lint_staged_proof "$task_config" "$path"
    ((count+=1))
  done
  [[ $(jq -er '.proofs | length' "$assembly") == "$count" ]] ||
    finish fault setup "assembly needs exactly the frozen plan's tasks"
  config=$workspace/problems/$task/problem.json
  [[ -f $config ]] || finish fault setup "missing frozen assembly plan"
  proof=$(module_path "$(json_string solution_module "$config")")
}

require_source() {
  local path=$1 expected=$2
  [[ -f $workspace/$path && ! -L $workspace/$path ]] ||
    finish rejected plan "missing regular Lean source: $path"
  if [[ $(tr -d '[:space:]' <"$workspace/$path") != "$(tr -d '[:space:]' <<<"$expected")" ]]; then
    finish rejected plan "$path must declare the manifest's exact claim using the authoring template"
  fi
}

stage_plan() {
  local diff manifest ns theorem task_id task_module task_name claim signature="" imports="" args=""
  local -a challenges=()
  diff=$(git -C "$base" diff --no-renames --name-only "$base_sha" "$head_sha") ||
    finish fault files "could not read the problem diff"
  if git -C "$base" diff --raw --no-renames "$base_sha" "$head_sha" |
     grep -qvE '^:000000 100644 [0-9a-f]+ [0-9a-f]+ A[[:space:]]'; then
    finish rejected files "a problem PR may only add regular files"
  fi
  manifest=$(grep -Ex 'problems/[a-z0-9]+(-[a-z0-9]+)*/publication\.json' <<<"$diff") ||
    finish rejected files "missing publication manifest"
  [[ $manifest != *$'\n'* ]] || finish rejected files "expected one publication manifest"
  task=${manifest#problems/}
  task=${task%/publication.json}
  local metadata=$workspace/$manifest
  ns=$(jq -er '.namespace | select(test("^[A-Z][A-Za-z0-9_]*$"))' "$metadata") ||
    finish rejected files "invalid Lean namespace"
  theorem=$(jq -er '.theorem | select(test("^[A-Za-z_][A-Za-z0-9_]*$"))' "$metadata") ||
    finish rejected files "invalid problem theorem"
  local files="^((Proofs|Challenges)/$ns/[^/]+\.lean|problems/$task/(README\.md|publication\.json|problem\.json|tasks/[a-z0-9-]+\.json))$"
  if grep -qvEx "$files" <<<"$diff"; then
    finish rejected files "a problem PR may only change the planned problem's files"
  fi
  while IFS=$'\t' read -r task_id task_module task_name claim; do
    [[ $task_id =~ ^[a-z0-9-]+$ && $task_module =~ ^[A-Z][A-Za-z0-9_]*$ &&
       $task_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ && $claim =~ ^[A-Z][A-Za-z0-9_]*$ ]] ||
      finish rejected files "invalid task manifest entry"
    [[ ! -e $workspace/Proofs/$ns/$task_module.lean && ! -L $workspace/Proofs/$ns/$task_module.lean ]] ||
      finish rejected files "task proof files are reserved for submissions"
    require_source "Challenges/$ns/$task_module.lean" "import Proofs.$ns.Claims
      theorem $ns.$task_name : $ns.$claim := by sorry"
    signature+="$ns.$claim → "
    imports+=$'\n'"import Proofs.$ns.$task_module"
    args+=" $ns.$task_name"
    challenges+=("Challenges.$ns.$task_module")
    cp "$workspace/Challenges/$ns/$task_module.lean" "$workspace/Proofs/$ns/$task_module.lean" ||
      finish fault setup "could not prepare the assembly check"

  done < <(jq -er '.tasks[] | [.id, .module, .theorem, .claimConstant] | @tsv' "$metadata")
  [[ ${#challenges[@]} -gt 0 ]] || finish rejected files "expected at least one task"
  require_source "Challenges/$ns/Problem.lean" "import Proofs.$ns.Claims
    theorem $ns.$theorem : $ns.ProblemClaim := by sorry"
  require_source "Proofs/$ns/Solution.lean" "import Proofs.$ns.Plan$imports
    theorem $ns.$theorem : $ns.ProblemClaim := $ns.plan$args"
  proof=Proofs/$ns/Plan.lean
  [[ -f $workspace/$proof && ! -L $workspace/$proof ]] || finish rejected plan "missing regular plan source"
  local claims_file=Proofs/$ns/Claims.lean
  local expected=Challenges.$ns.PublicationPlan reasons
  if ! reasons=$(lint_proof "$workspace/$claims_file" /dev/null) ||
     ! reasons=$(lint_proof "$workspace/$proof" "$workspace/Challenges/$ns/Problem.lean"); then
    finish rejected rules "$reasons"
  fi
  plan_modules=("Challenges.$ns.Problem" "${challenges[@]}" "Proofs.$ns.Solution")

  printf 'import Proofs.%s.Claims\ntheorem %s.plan : %s%s.ProblemClaim := by sorry\n' \
    "$ns" "$ns" "$signature" "$ns" >"$workspace/Challenges/$ns/PublicationPlan.lean" ||
    finish fault setup "could not generate the plan challenge"
  config=$work/plan.json
  jq -n --arg challenge "$expected" --arg solution "Proofs.$ns.Plan" --arg name "$ns.plan" \
    '{challenge_module:$challenge,solution_module:$solution,theorem_names:[$name],
      permitted_axioms:["propext","Quot.sound","Classical.choice"],external_kernels:{nanoda:["nanoda_bin"]}}' >"$config" ||
    finish fault setup "could not prepare the plan check"
}

stage_revision() {
  local manifest diff retired old_cfg old_module old_challenge old_theorem old_claim old_import
  local ns prefix claims plan lemma bridge config_path new_id index=0 module name constant
  local signature="" imports="" args="" reasons
  local -a changed=() expected_paths=()
  diff=$(git -C "$base" diff --no-renames --name-only "$base_sha" "$head_sha") ||
    finish fault files "could not read the revision diff"
  manifest=$(grep -Ex 'problems/[a-z0-9]+(-[a-z0-9]+)*/revisions/[a-z0-9]+(-[a-z0-9]+)*\.json' <<<"$diff") ||
    finish rejected files "missing task revision manifest"
  [[ $manifest != *$'\n'* ]] || finish rejected files "expected one task revision manifest"
  retired=$(basename "$manifest" .json)
  task=${manifest#problems/}
  task=${task%%/*}
  local root="problems/$task"
  config_path=$root/tasks/$retired.json
  old_cfg=$work/retired-task.json
  git -C "$base" show "$base_sha:$config_path" >"$old_cfg" || finish rejected files "missing retired task config"
  old_module=$(json_string solution_module "$old_cfg")
  [[ $old_module =~ ^Proofs\.([A-Z][A-Za-z0-9_]*)\.[A-Z][A-Za-z0-9_]*$ ]] ||
    finish rejected files "invalid retired proof module"
  ns=${BASH_REMATCH[1]}
  bridge=$(module_path "$old_module")
  old_challenge=$(module_path "$(json_string challenge_module "$old_cfg")")
  old_theorem=$(json_theorems "$old_cfg")
  [[ $old_theorem =~ ^$ns\.[A-Za-z_][A-Za-z0-9_]*$ ]] ||
    finish rejected files "invalid retired theorem"
  old_import=$(file_imports "$workspace/$old_challenge")
  old_claim=$(jq -er --arg ns "$ns" '.oldClaim | select(test("^" + $ns + "\\.[A-Za-z_][A-Za-z0-9_]*$"))' "$workspace/$manifest") ||
    finish rejected files "invalid retired claim constant"
  [[ $old_import =~ ^Proofs\.$ns\.[A-Za-z_][A-Za-z0-9_]*$ ]] ||
    finish rejected files "invalid retired claims module"
  require_source "$old_challenge" "import $old_import
    theorem $old_theorem : $old_claim := by sorry"
  prefix=$(jq -er '.prefix | select(test("^Revision[0-9a-f]{16}$"))' "$workspace/$manifest") ||
    finish rejected files "invalid revision module prefix"
  mapfile -t changed < <(jq -er '.tasks | select(type == "array" and length >= 1 and length <= 10) | .[] |
    select(type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$"))' "$workspace/$manifest")
  [[ ${#changed[@]} -gt 0 ]] || finish rejected files "missing replacement tasks"

  claims=Proofs.$ns.${prefix}Claims
  plan=Proofs.$ns.${prefix}Plan
  lemma=$ns.${prefix}ImpliesRetiredClaim
  proof=$(module_path "$plan")
  expected_paths=("$manifest" "$config_path" "$bridge" "$(module_path "$claims")" "$proof")
  imports="import $plan"
  for new_id in "${changed[@]}"; do
    ((index+=1))
    module=${prefix}Task$index
    name=$ns.${prefix}Proof$index
    constant=$ns.${prefix}Claim$index
    signature+="$constant → "
    imports+=$'\n'"import Proofs.$ns.$module"
    args+=" $name"
    config_path=$root/tasks/$new_id.json
    local challenge_file="Challenges/$ns/$module.lean"
    expected_paths+=("$config_path" "$challenge_file")
    jq -e --arg c "Challenges.$ns.$module" --arg s "Proofs.$ns.$module" --arg t "$name" '
      . == {challenge_module:$c, solution_module:$s, theorem_names:[$t],
        permitted_axioms:["propext","Quot.sound","Classical.choice"],external_kernels:{nanoda:["nanoda_bin"]}}
    ' "$workspace/$config_path" >/dev/null || finish rejected files "invalid replacement task config"
    require_source "$challenge_file" "import $claims
      theorem $name : $constant := by sorry"
    [[ ! -e $workspace/Proofs/$ns/$module.lean && ! -L $workspace/Proofs/$ns/$module.lean ]] ||
      finish rejected files "replacement proof files are reserved for submissions"
    cp "$workspace/$challenge_file" "$workspace/Proofs/$ns/$module.lean" ||
      finish fault setup "could not prepare the replacement proof placeholder"
  done

  [[ $(printf '%s\n' "${expected_paths[@]}" | sort) == "$(sort <<<"$diff")" ]] ||
    finish rejected files "a task revision may only replace the retired config and add the revision files"
  local retired_config="$root/tasks/$retired.json"
  local status
  status=$(git -C "$base" diff --raw --no-renames "$base_sha" "$head_sha") ||
    finish fault files "could not verify revision file modes"
  while IFS=$'\t' read -r metadata path; do
    if [[ $path == "$retired_config" ]]; then
      [[ $metadata =~ ^:100644\ 000000\ [0-9a-f]+\ [0-9a-f]+\ D$ ]] ||
        finish rejected files "the retired task config must be deleted"
    else
      [[ $metadata =~ ^:000000\ 100644\ [0-9a-f]+\ [0-9a-f]+\ A$ ]] ||
        finish rejected files "the revision may only add new regular files"
    fi
  done <<<"$status"

  require_source "$bridge" "$imports
    theorem $old_theorem : $old_claim := $lemma$args"
  local expected=Challenges.$ns.${prefix}Plan
  printf 'import %s\ntheorem %s : %s%s := by sorry\n' "$claims" "$lemma" "$signature" "$old_claim" \
    >"$workspace/$(module_path "$expected")" || finish fault setup "could not generate the revision challenge"
  if ! reasons=$(lint_proof "$workspace/$(module_path "$claims")" "$workspace/$old_challenge") ||
     ! reasons=$(lint_proof "$workspace/$proof" "$workspace/$(module_path "$expected")"); then
    finish rejected rules "$reasons"
  fi

  plan_modules=("$old_module")
  config=$work/revision.json
  jq -n --arg challenge "$expected" --arg solution "$plan" --arg name "$lemma" \
    '{challenge_module:$challenge,solution_module:$solution,theorem_names:[$name],
      permitted_axioms:["propext","Quot.sound","Classical.choice"],external_kernels:{nanoda:["nanoda_bin"]}}' \
    >"$config" || finish fault setup "could not prepare the revision check"
}

if [[ -n $assembly ]]; then
  stage_assembly
elif [[ $input == --plan ]]; then
  stage_plan
elif [[ $input == --revision ]]; then
  stage_revision
else
  stage_task_proof "${5:-HEAD}"
fi
# Keep comparator configuration outside the sandbox's writable source tree.
judge_config=$claim_export/config.json
cp "$config" "$judge_config" || finish fault setup "could not pin the comparator config"
module=$(json_string solution_module "$judge_config")
challenge_module=$(json_string challenge_module "$judge_config")
mapfile -t theorems < <(json_theorems "$judge_config")

cd "$workspace" || finish fault setup "missing workspace"
export ELAN_HOME=$work/elan HOME=$work/home
ensure_lean || finish fault setup "could not install the pinned toolchain"
fetch_mathlib "$proof" "$(module_path "$challenge_module")" ||
  finish fault setup "could not fetch dependencies or the Mathlib cache"
# Lake writes a hash beside the trusted widget lockfile even when it replays a cached build.
if "$plan_input" && [[ -d .lake/packages/proofwidgets ]]; then
  lake build proofwidgets/widgetPackageLock >&2 || finish fault setup "could not prepare the widget lockfile"
fi
docker build --quiet --tag proof-sandbox --file "$base/scripts/checker/sandbox.Dockerfile" \
  "$base/scripts/checker" >/dev/null || finish fault setup "could not build the sandbox image"

log "Exporting the frozen claim $challenge_module"
if ! "$plan_input"; then
  export_module "$challenge_module" "$claim_export/claim.ndjson" "${theorems[@]}" ||
    finish fault claim "could not build or export the frozen claim"
fi

log "Probing the sandbox before it runs submitted code"
probe=$(sandboxed 60 -- sh -c '
  if env | grep -E "^(GITHUB|ACTIONS|RUNNER)_"; then echo "credentials or runner state leak in"; exit 3; fi
  if git ls-remote https://github.com/leanprover/lean4 HEAD >/dev/null 2>&1; then echo "network reachable"; exit 3; fi
  echo "no network, no GitHub or runner variables, memory.max=$(cat /sys/fs/cgroup/memory.max)" \
    "pids.max=$(cat /sys/fs/cgroup/pids.max) cpu.max=$(cat /sys/fs/cgroup/cpu.max) uid=$(id -u)"
' 2>&1) || finish fault sandbox "the sandbox is not isolated: $probe"
log "Sandbox: $probe"

if "$plan_input"; then
  sandboxed "$CHECK_BUILD_TIMEOUT" --volume "$workspace:$workspace" \
    --volume "$workspace/.lake/packages:$workspace/.lake/packages:ro" \
    --volume "$base/scripts/checker/lib.sh:/tmp/checker-lib.sh:ro" \
    --volume "$claim_export:$claim_export" --workdir "$workspace" -- bash -c '
    . /tmp/checker-lib.sh
    lake build "${@:4}" >&2 &&
    export_module "$1" "$2/claim.ndjson" "$3"
  ' bash "$challenge_module" "$claim_export" "${theorems[0]}" "${plan_modules[@]}" >"$out/plan.log" 2>&1 ||
    finish rejected plan "could not build the expected plan statement
$(tail -n 40 "$out/plan.log")"
fi

log "Building and exporting the submission in the sandbox"
# The claim export stays outside this container, so code run while elaborating the submission
# can only change the submission's own export, which the kernels then check.
sandboxed "$CHECK_BUILD_TIMEOUT" --volume "$workspace:$workspace" \
  --volume "$workspace/.lake/packages:$workspace/.lake/packages:ro" \
  --volume "$base/scripts/checker/lib.sh:/tmp/checker-lib.sh:ro" \
  --volume "$submission_export:$submission_export" --workdir "$workspace" -- bash -c '
  . /tmp/checker-lib.sh
  export_module "$1" "$2/solution.ndjson" "${@:3}"
' bash "$module" "$submission_export" "${theorems[@]}" >"$out/build.log" 2>&1
build_status=$?
build_log=$(grep -v 'designed for use with the module system' "$out/build.log" | tail -n 40)
case $build_status in
  0) ;;
  10)
    # A Lean error in a source file is the submission's fault; anything else is the runner's.
    if grep -q -E '\.lean:[0-9]+:[0-9]+: error|error: [^ ]+\.lean:[0-9]+' "$out/build.log"; then
      finish rejected build "$build_log"
    fi
    finish fault build "the build failed without a Lean error
$build_log"
    ;;
  # The module built, so a failed export points at the runner, such as a full disk.
  11) finish fault export "$build_log" ;;
  124 | 137) finish rejected limits "the build exceeded ${CHECK_BUILD_TIMEOUT}s or ${CHECK_MEMORY} (exit $build_status)
$build_log" ;;
  *) finish fault build "the sandbox failed to run (exit $build_status)
$build_log" ;;
esac

log "Judging the exports with comparator"
sandboxed "$CHECK_JUDGE_TIMEOUT" --volume "$base:$base:ro" --volume "$claim_export:$claim_export:ro" \
  --volume "$submission_export:$submission_export:ro" --workdir "$base" -- \
  lake comparator --inadvisably-no-sandbox --config="$judge_config" \
  --challenge-from-export="$claim_export/claim.ndjson" \
  --solution-from-export="$submission_export/solution.ndjson" \
  >"$out/judge.log" 2>&1
judge_status=$?
judge_log=$(grep -v -e 'designed for use with the module system' -e 'Sandbox disabled' "$out/judge.log" | tail -n 40)
case $judge_status in
  0) finish accepted comparator "$judge_log" ;;
  1) finish rejected comparator "$judge_log" ;;
  124 | 137) finish rejected limits "the kernels exceeded ${CHECK_JUDGE_TIMEOUT}s or ${CHECK_MEMORY} (exit $judge_status)
$judge_log" ;;
  *) finish fault comparator "comparator could not run (exit $judge_status)
$judge_log" ;;
esac
