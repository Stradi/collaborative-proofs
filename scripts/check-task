#!/usr/bin/env bash
# Checks one task proof against its frozen claim with the pinned Lean and Mathlib.
# Usage: scripts/check-task <problem>/<task>      e.g. scripts/check-task weak-giuga/reciprocal-sum
#        scripts/check-task <problem>             checks the assembled proof of the whole problem
# Exit codes: 0 accepted, 1 rejected, 2 the check could not run.
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 2
# shellcheck source=checker/lib.sh
. scripts/checker/lib.sh

fail_to_run() { log "Could not run the check: $*"; exit 2; }

task=${1:-}
[[ -n $task ]] || fail_to_run "usage: scripts/check-task <problem>/<task>"
if [[ $task == */* ]]; then config=$(task_config "$task"); else config=problems/$task/problem.json; fi
[[ -f $config ]] || fail_to_run "no config at $config"
proof=$(module_path "$(json_string solution_module "$config")")
challenge=$(module_path "$(json_string challenge_module "$config")")
[[ -f $proof ]] || fail_to_run "write the proof in $proof first"

started=$SECONDS
# The assembled proof is maintainer code that imports the plan and the merged task proofs.
if [[ $task == */* ]] && ! reasons=$(lint_proof "$proof" "$challenge"); then
  printf '%s\n' "$reasons" >&2
  log "REJECTED: $proof breaks the submission rules"
  exit 1
fi

ensure_lean || fail_to_run "could not install Lean"
fetch_mathlib "$proof" "$challenge" || fail_to_run "could not fetch dependencies or the Mathlib cache"
log "Setup took $((SECONDS - started))s"

exports=$(mktemp -d)
trap 'rm -rf "$exports"' EXIT
mapfile -t theorems < <(json_theorems "$config")
checked=$SECONDS
export_module "$(json_string challenge_module "$config")" "$exports/claim.ndjson" "${theorems[@]}" ||
  fail_to_run "could not build or export the frozen claim"
export_module "$(json_string solution_module "$config")" "$exports/solution.ndjson" "${theorems[@]}"
case $? in
  0) ;;
  10) log "REJECTED: $proof does not build"; exit 1 ;;
  *) fail_to_run "$proof builds but could not be exported" ;;
esac
# Comparator's bwrap sandbox needs user namespaces that many agent machines lack. This proof is the
# agent's own code, and CI rechecks the PR in isolation.
lake comparator --inadvisably-no-sandbox --config="$config" \
  --challenge-from-export="$exports/claim.ndjson" --solution-from-export="$exports/solution.ndjson"
status=$?
log "Checking took $((SECONDS - checked))s"
case $status in
  0) log "ACCEPTED: $task" ;;
  1) log "REJECTED: $task" ;;
  *) log "Could not run comparator (exit $status)"; status=2 ;;
esac
exit "$status"
